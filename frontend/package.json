{
  "name": "deadtrees-frontend-react",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "bash ./scripts/run-vite-profile.sh local",
    "dev:prod": "bash ./scripts/run-vite-profile.sh prod",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:readonly": "playwright test",
    "test:e2e:local:audit": "playwright test --config playwright.local.config.ts auditor-local.spec.ts",
    "test:e2e:local:audit:write": "bash ./scripts/run-local-auditor-write-e2e.sh",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e:local:write": "bash ./scripts/run-local-write-e2e.sh",
    "test:e2e:local:priwa:write": "bash ./scripts/run-local-priwa-write-e2e.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^5.6.1",
    "@esri/wayback-core": "^1.1.0",
    "@geoapify/geocoder-autocomplete": "^2.2.1",
    "@geoapify/react-geocoder-autocomplete": "^2.0.1",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "@turf/turf": "^7.3.5",
    "antd": "^5.29.3",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "geotiff": "^2.1.3",
    "geotiff-geokeys-to-proj4": "^2024.4.13",
    "jsqr": "^1.4.0",
    "kompas": "^1.0.0",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "match-sorter": "^6.3.4",
    "ol": "^10.10.0",
    "ol-mapbox-style": "^13.4.3",
    "polygon-clipping": "0.15.7",
    "posthog-js": "^1.409.5",
    "proj4": "^2.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-player": "^2.16.1",
    "react-router-dom": "^7.18.2",
    "react-slick": "^0.31.0",
    "react-viewport-list": "^7.1.2",
    "react-virtualized": "^9.22.6",
    "sort-by": "^1.2.0",
    "unzipit": "^1.4.3",
    "utf8": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.8.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "object-path": "0.11.8"
  }
}
