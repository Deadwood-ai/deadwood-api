ENV=development
DEV_MODE=true
COMPOSE_PROJECT_NAME=deadtrees-test

# Local Supabase CLI defaults (`supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local test stack defaults
PROCESSOR_PASSWORD=processor
# Optional override; use a stable unique value per processor host.
PROCESSOR_WORKER_ID=
PROCESSOR_LOOP_FAILURE_LIMIT=3
# Comma-separated task types this worker refuses to run (e.g. odm_processing).
# Queue entries whose task_types include any of these are skipped so another
# (capable) worker picks them up. Leave empty to run every task type.
PROCESSOR_TASK_BLACKLIST=
# Gitignored host directory bind-mounted at /processor-control in the worker.
# Relative paths are resolved from the repository root.
PROCESSOR_CONTROL_DIR=./.local/processor-control
# Host directory containing production models and metadata. Relative paths are
# resolved from the repository root. Use an absolute shared path when deploys
# run from a separate operator checkout.
PROCESSOR_ASSETS_DIR=./assets
# Per-host resource caps for the production processor container
# (docker-compose.processor.yaml). On machines smaller than the defaults, lower
# PROCESSOR_CPU_LIMIT to <= the host's CPU core count. Defaults: 30 CPUs / 96G.
PROCESSOR_CPU_LIMIT=30
PROCESSOR_MEMORY_LIMIT=96G
# Path to the processor->storage private key (the .pub is derived by appending
# .pub). Defaults to ~/.ssh/processing-to-storage. Set this to a LOCAL-disk path
# when the home dir is on NFS with root-squash, since the root Docker daemon
# cannot bind-mount from such a home (fails with "mkdir ...: permission denied").
PROCESSOR_SSH_KEY_PATH=
STORAGE_SERVER_USERNAME=root
STORAGE_SERVER_DATA_PATH=/data
SSH_PRIVATE_KEY_PASSPHRASE=
# Operator scripts default to this OpenSSH trust store. Production processors
# use the reviewed host key in processor/config/storage_known_hosts.
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
TCD_CONTAINER_IMAGE=deadtrees-tcd:latest
TCD_CONTAINER_TIMEOUT_SECONDS=14400
TCD_CONTAINER_TIMEOUT_MAX_SECONDS=43200
TCD_CONTAINER_TIMEOUT_BASE_PIXELS=2000000000

# API/reference export runtime.
DEADTREES_USER=
DEADTREES_PASSWORD=
REFERENCE_EXPORT_UUID=
NGINX_COG_URL=http://localhost:8080/cogs/v1

# Optional integrations. Leave blank unless you are running the related service.
LOGFIRE_TOKEN=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
ZULIP_EMAIL=
ZULIP_API_KEY=
ZULIP_SITE=
ZULIP_STREAM=project_deadtree.earth
ZULIP_TOPIC=Daily Summary
LINEAR_ENABLED=false
LINEAR_API_KEY=
LINEAR_TEAM_ID=ba4011bf-0b5c-4631-9f88-1034ab4ef541
FREIDATA_TOKEN=
BREVO_API_KEY=
NOTIFICATION_SENDER_EMAIL=notifications@deadtrees.earth
NOTIFICATION_SENDER_NAME=DeadTrees
PROCESSING_EMAIL_NOTIFICATIONS_ENABLED=false
PROCESSING_FAILURE_EMAIL_HOLIDAY_NOTE_UNTIL=2026-09-15

# Do not add VPN, manual SSH, MCP bearer tokens, or personal credentials here.
# See docs/agents/environment-and-access.md for where local-only access belongs.
